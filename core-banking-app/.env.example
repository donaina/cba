# Database
DATABASE_URL=postgresql://cba:cba_secret@localhost:5432/cba_db

# JWT
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cba-documents

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# External integrations
NIBSS_BASE_URL=https://nibss-sandbox.example.com
NIBSS_SANDBOX=true

TERMII_API_KEY=your-termii-key
TERMII_SENDER_ID=YourBank
TERMII_SANDBOX=true

SENDGRID_API_KEY=SG.your-key
SENDGRID_FROM_EMAIL=noreply@yourbank.ng
SENDGRID_SANDBOX=true

CREDIT_BUREAU_API_KEY=your-crc-key
CREDIT_BUREAU_SANDBOX=true

AML_WEBHOOK_SECRET=change-me-aml-secret

# App
PORT=3000
CORS_ORIGINS=http://localhost:3001
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
NODE_ENV=development
